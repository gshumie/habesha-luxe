# Habesha Luxe - Environment Variables

# Chapa Payment Gateway Configuration
# Obtain your keys from the Chapa Dashboard (https://dashboard.chapa.co)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_webhook_secret_here

# Base URL for redirects and webhooks
# Locally: http://localhost:3000
# Production: https://habeshaluxe.com (or your Vercel deployment URL)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin Access Passcode for Store Management
ADMIN_SECRET_KEY=habesha-luxe-admin-2025

# Simulation Mode: if "true" or when Chapa test keys fail or are empty, provides a simulated Chapa gateway for seamless offline QA
NEXT_PUBLIC_ENABLE_SIMULATED_PAYMENT=true
